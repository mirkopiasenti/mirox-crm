[Unit]
Description=Controllo archivio Mirox e restore DB isolato
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/mirox-backup
LoadCredential=private.json:/etc/mirox-backup/private.json
ExecStart=/opt/mirox-backup/venv/bin/python scripts/backup/audit.py --state-dir /var/lib/mirox-backup-audit
StateDirectory=mirox-backup-audit
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
Environment=PYTHONDONTWRITEBYTECODE=1
